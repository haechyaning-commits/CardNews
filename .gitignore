__pycache__/
*.pyc
.env
.DS_Store

# 사진 관련 산출물만 커밋 제외. approved_script.json/output_script.json/
# review_log.json/stability_report.json은 "포트폴리오에서 몇 번 반려 끝에
# 통과했는지, 최종 승인본이 뭔지 그대로 보여준다"는 목적으로 orchestrator.py/
# stability_test.py가 일부러 남기는 파일이라 오히려 커밋해서 증거로 남긴다
# (한 번 놔뒀다가 실수로 이걸 다 gitignore에 넣었었음 — 코드 주석에 적힌
# 원래 의도랑 반대라 되돌림).
photo_assignments.json
crop_manifest.json
banned_photos.json
images/
preview.html

# 디자이너 에이전트 산출물도 같은 이유(실제 다운로드한 사진이 박혀 있는
# 바이너리 결과물)로 제외. final_manifest.json은 crop_manifest.json과
# 마찬가지로 images/의 로컬 경로를 참조하는 파일이라 같이 뺀다.
final/
final_manifest.json

# 폰트 파일은 라이선스 파일(OFL.txt 등)까지 같이 챙겨야 하고 용량도 커서
# 커밋하지 않는다 — fonts/ 폴더를 만들어 Noto Sans KR을 직접 받아 넣으면 됨
# (designer_agent.py 상단 사용법 참고).
fonts/

# 예전에 실수로 잘못된 경로에 저장된 잔여 파일 (Finder에서 수동으로 지워도 됨)
Claude outputs/
